Set-Content .gitignore @"
# Entornos virtuales y caché de Python
.venv/
backend/.venv/
venv/
backend/venv/
__pycache__/
backend/__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencias de Node / React
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Modelos pesados de IA y base vectorial local
*.gguf
*.pt
*.bin
*.onnx
*.safetensors
chroma_db/
backend/chroma_db/
chroma_data/

# Variables de entorno y configs locales
.env
backend/.env
frontend/.env
.vscode/
.DS_Store
Thumbs.db
"@