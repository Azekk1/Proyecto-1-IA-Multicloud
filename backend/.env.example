# ==============================================================================
# DERMAGUARD AI - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo como '.env' en la carpeta 'backend/':
#    cp .env.example .env  (o en Windows: copy .env.example .env)
# 2. Reemplaza los valores con las credenciales asignadas de tu recurso Azure.
# ==============================================================================

# --- 1. Inferencia Cloud: Azure AI Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://dermaguard-ai16-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=tu_azure_openai_api_key_aqui
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- 2. Inferencia Local Contingente: LM Studio (Fallback Offline) ---
# Si Azure no está disponible o no se configuran claves, el sistema conmuta aquí:
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions

